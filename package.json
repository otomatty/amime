{
	"name": "tsuzuri",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "pnpm --filter @tsuzuri/web dev",
		"build": "pnpm --filter @tsuzuri/web build",
		"build:e2e": "pnpm --filter @tsuzuri/web exec cf build --mode e2e",
		"lint": "biome ci --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"typecheck": "pnpm -r --parallel typecheck && tsc -p scripts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:server": "pnpm --filter @tsuzuri/web test:server",
		"test:e2e": "pnpm build:e2e && pnpm --filter @tsuzuri/e2e test",
		"check:unused": "knip",
		"check:tdd": "node scripts/check-test-first.ts",
		"check:size": "node scripts/check-size.ts",
		"test:mutation": "stryker run",
		"check": "pnpm lint && pnpm typecheck && pnpm check:unused && pnpm test:coverage && pnpm test:server && pnpm build && pnpm check:size",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"fast-check": "^4.10.2",
		"knip": "^6.45.1",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
