{
	"name": "amime",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "pnpm --filter @amime/web dev",
		"build": "pnpm --filter @amime/web build",
		"lint": "biome ci .",
		"lint:fix": "biome check --write .",
		"typecheck": "pnpm -r --parallel typecheck && tsc -p scripts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:server": "pnpm --filter @amime/web test:server",
		"test:e2e": "pnpm --filter @amime/e2e test",
		"check:unused": "knip",
		"check:tdd": "node scripts/check-test-first.ts",
		"check": "pnpm lint && pnpm typecheck && pnpm check:unused && pnpm test:coverage && pnpm test:server && pnpm build",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^5.1.0",
		"fast-check": "^4.10.2",
		"knip": "^6.45.1",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
